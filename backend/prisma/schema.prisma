generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String
  passwordHash     String
  role             String       @default("STAFF") // ADMIN, STAFF, CUSTOMER
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer         Customer?
  recordedPayments Payment[]
  auditLogs        AuditLog[]
}

model Customer {
  id               String         @id @default(cuid())
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName      String
  contactName      String
  email            String         @unique
  phone            String?
  street           String?
  city             String?
  country          String?        @default("India")
  taxNumber        String?
  paymentTerms     String         @default("Net 15") // Immediate, Net 15, Net 30
  status           String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  quotations       Quotation[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  payments         Payment[]

  @@index([email])
  @@index([companyName])
}

model Product {
  id               String           @id @default(cuid())
  name             String
  type             String           @default("Software") // Software, Add-on, Service
  salesPrice       Float
  costPrice        Float            @default(0.0)
  notes            String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  plans            Plan[]
  discounts        Discount[]
  quotationLines   QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines     InvoiceLine[]
}

model ProductVariant {
  id               String            @id @default(cuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName      String            // e.g. "Odoo Brand", "Standard", "Enterprise"
  priceAdjustment  Float             @default(0.0) // e.g. +560
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  quotationLines   QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines     InvoiceLine[]

  @@index([productId])
}

model Plan {
  id                String             @id @default(cuid())
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String             // e.g. "Business Monthly", "Enterprise Annual"
  billingFrequency  String             // DAILY, WEEKLY, MONTHLY, YEARLY
  price             Float              // Base plan recurring rate
  minQuantity       Int                @default(1)
  startDate         DateTime?
  endDate           DateTime?
  autoCloseOnEnd    Boolean            @default(false)
  allowPause        Boolean            @default(true)
  allowEarlyClose   Boolean            @default(true)
  allowRenewal      Boolean            @default(true)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  quotationTemplates QuotationTemplate[]
  quotations        Quotation[]
  subscriptions     Subscription[]

  @@index([productId])
  @@index([billingFrequency])
}

model Tax {
  id               String         @id @default(cuid())
  name             String         // e.g. "GST 18%", "VAT 5%"
  rate             Float          // percentage e.g. 18.0
  taxType          String         @default("PERCENTAGE")
  isDefault        Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Discount {
  id               String         @id @default(cuid())
  name             String         // e.g. "Bulk Seats 10%", "Volume Festive ₹1000"
  discountType     String         // PERCENTAGE, FIXED
  discountValue    Float          // 10.0 or 1000.0
  minPurchase      Float          @default(0.0)
  minQuantity      Int            @default(1)
  startDate        DateTime?
  endDate          DateTime?
  usageLimit       Int?           // Max times it can be applied
  usageCount       Int            @default(0)
  scope            String         @default("SUBSCRIPTION") // SUBSCRIPTION, SPECIFIC_PRODUCT
  targetProductId  String?
  targetProduct    Product?       @relation(fields: [targetProductId], references: [id], onDelete: SetNull)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model QuotationTemplate {
  id               String                 @id @default(cuid())
  name             String                 // e.g. "Standard Enterprise Onboarding"
  planId           String
  plan             Plan                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  validityDays     Int                    @default(30)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  templateLines    QuotationTemplateLine[]
  quotations       Quotation[]
}

model QuotationTemplateLine {
  id               String            @id @default(cuid())
  templateId       String
  template         QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId        String
  variantId        String?
  quantity         Int               @default(1)
  unitPrice        Float

  @@index([templateId])
}

model Quotation {
  id               String          @id @default(cuid())
  quotationNumber  String          @unique // QT-2026-0001
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  templateId       String?
  template         QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  validityDate     DateTime
  paymentTerms     String          @default("Net 15")
  status           String          @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, CANCELLED
  subtotal         Float           @default(0.0)
  discountAmount   Float           @default(0.0)
  taxAmount        Float           @default(0.0)
  totalAmount      Float           @default(0.0)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lines            QuotationLine[]
  subscription     Subscription?

  @@index([customerId])
  @@index([status])
}

model QuotationLine {
  id               String          @id @default(cuid())
  quotationId      String
  quotation        Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity         Int             @default(1)
  unitPrice        Float
  taxRate          Float           @default(0.0)
  amount           Float

  @@index([quotationId])
}

model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String             @unique // SUB-2026-0001
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  quotationId        String?            @unique
  quotation          Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status             String             @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  nextBillingDate    DateTime
  lastBilledDate     DateTime?
  paymentTerms       String             @default("Net 15")
  autoCloseOnEnd     Boolean            @default(false)
  allowPause         Boolean            @default(true)
  allowEarlyClose    Boolean            @default(true)
  allowRenewal       Boolean            @default(true)
  subtotal           Float              @default(0.0)
  discountAmount     Float              @default(0.0)
  taxAmount          Float              @default(0.0)
  totalAmount        Float              @default(0.0)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  lines              SubscriptionLine[]
  invoices           Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id               String          @id @default(cuid())
  subscriptionId   String
  subscription     Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity         Int             @default(1)
  unitPrice        Float
  taxRate          Float           @default(0.0)
  amount           Float

  @@index([subscriptionId])
}

model Invoice {
  id                  String         @id @default(cuid())
  invoiceNumber       String         @unique // INV-2026-0001
  subscriptionId      String
  subscription        Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  issueDate           DateTime       @default(now())
  dueDate             DateTime
  status              String         @default("DRAFT") // DRAFT, CONFIRMED, PAID, OVERDUE, CANCELLED
  subtotal            Float          @default(0.0)
  discountAmount      Float          @default(0.0)
  taxAmount           Float          @default(0.0)
  totalAmount         Float          @default(0.0)
  amountPaid          Float          @default(0.0)
  amountDue           Float          @default(0.0)
  sentAt              DateTime?
  cancelledAt         DateTime?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lines               InvoiceLine[]
  payments            Payment[]

  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd]) // CRITICAL: Guarantees no duplicate billing!
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description      String
  quantity         Int             @default(1)
  unitPrice        Float
  taxRate          Float           @default(0.0)
  amount           Float

  @@index([invoiceId])
}

model Payment {
  id               String          @id @default(cuid())
  paymentNumber    String          @unique // PAY-2026-0001
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount           Float
  paymentMethod    String          // CREDIT_CARD, BANK_TRANSFER, UPI, CASH, OTHER
  paymentDate      DateTime        @default(now())
  referenceNumber  String?
  notes            String?
  recordedByUserId String?
  recordedByUser   User?           @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // CREATE, UPDATE, DELETE, BILLING_RUN, PAYMENT, STATUS_CHANGE
  entityType  String   // SUBSCRIPTION, INVOICE, PAYMENT, PRODUCT, PLAN, DISCOUNT
  entityId    String
  details     String?  // JSON string or summary
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
